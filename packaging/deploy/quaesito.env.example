# Settings for the quaesito service. Copy to /etc/quaesito/quaesito.env and make it
# readable by root only (sudo chmod 600 /etc/quaesito/quaesito.env). Never commit the real file.

# The address players open: join links and the QR code use it. HTTPS, no trailing slash.
QUAESITO_PUBLIC_URL=https://quiz.example.com

# The admin password. On the internet, use a long random one, for example from
#   openssl rand -base64 24
QUAESITO_ADMIN_PASSWORD=replace-with-a-long-random-password

# Already set by quaesito.service; uncomment to change.
#IP=127.0.0.1
#PORT=8080
#QUAESITO_DATA_DIR=/var/lib/quaesito

# Largest uploads, in MB (defaults shown).
#QUAESITO_MAX_PICTURE_MB=15
#QUAESITO_MAX_AUDIO_MB=40
#QUAESITO_MAX_VIDEO_MB=200
#QUAESITO_MAX_IMPORT_MB=500
